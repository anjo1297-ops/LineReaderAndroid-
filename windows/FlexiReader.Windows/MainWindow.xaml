<Window x:Class="FlexiReader.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlexiReader - Read Your Way" Height="760" Width="1100"
        MinHeight="500" MinWidth="760"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding SearchCommand}"/>
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding BookmarkCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PositionCommand}"/>
    </Window.InputBindings>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="OpenButton" Content="Open document" Width="130" Margin="0,0,8,0" Click="OpenButton_Click" AutomationProperties.Name="Open document, Control O"/>
            <Button Content="Search" Width="90" Margin="0,0,8,0" Click="SearchButton_Click" AutomationProperties.Name="Search document, Control F"/>
            <Button Content="Add bookmark" Width="120" Margin="0,0,8,0" Click="AddBookmarkButton_Click" AutomationProperties.Name="Add bookmark, Control B"/>
            <Button Content="Bookmarks" Width="100" Margin="0,0,8,0" Click="BookmarksButton_Click" AutomationProperties.Name="Bookmarks"/>
            <Button Content="Recent" Width="80" Margin="0,0,8,0" Click="RecentButton_Click" AutomationProperties.Name="Recent documents"/>
            <Button Content="Reading position" Width="130" Click="PositionButton_Click" AutomationProperties.Name="Reading position, Control P"/>
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Open a document to begin." AutomationProperties.LiveSetting="Polite"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="DocumentTitle" Grid.Row="0" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"
                       Text="FlexiReader" AutomationProperties.HeadingLevel="Level1"/>
            <RichTextBox x:Name="ReaderText" Grid.Row="1"
                         IsReadOnly="True"
                         IsDocumentEnabled="True"
                         FontSize="18"
                         Padding="8"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ReaderText_SelectionChanged"
                         KeyDown="ReaderText_KeyDown"
                         AutomationProperties.Name="Document text. Use the arrow keys to read normally."/>
        </Grid>
    </DockPanel>
</Window>
